# ==================== LLM & Embedding ====================
# 阿里云百炼 DashScope（embedding + rerank）：https://bailian.console.aliyun.com
DASHSCOPE_API_KEY=your-dashscope-api-key-here
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIMENSIONS=1024

# LLM（DeepSeek 官网，负责聊天）：https://platform.deepseek.com
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-pro
LLM_TEMPERATURE=0.7

# Rerank 精排（可选，false 则用本地 fallback）
RERANK_MODEL=gte-rerank
USE_RERANK=true

# ==================== RAG 参数 ====================
CHUNK_SIZE=300
CHUNK_OVERLAP=40
RETRIEVAL_TOP_K=5
RETRIEVAL_KEYWORD_WEIGHT=0.4
RETRIEVAL_VECTOR_WEIGHT=0.6
MAX_CONTEXT_LENGTH=4000

# 置信度拦截（HITL）：检索 top1 分数低于此值时拒绝硬答，直接提示人工核实
LOW_CONFIDENCE_THRESHOLD=0.25

# ==================== 向量库后端 ====================
# memory : 内存 FAISS HNSW（开发/演示，重启丢数据）
# milvus : Milvus + HNSW（生产，持久化，重启不丢；需先启动 Milvus 服务）
VECTOR_DB_TYPE=milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=finins_chunks

# ==================== 应用配置 ====================
APP_HOST=0.0.0.0
APP_PORT=8000
# 生产环境务必改成随机长字符串
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=1440
